      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nconst required = [\n  'intake_note_id',\n  'utterance_id',\n  'prompt_generation_id',\n  'delivery_id',\n  'contract_name',\n  'project_slug',\n  'prompt_type',\n  'destination',\n  'target_type',\n  'target_identifier',\n  'mode',\n  'priority',\n  'delivery_status',\n  'requires_review',\n  'template_name',\n  'final_prompt_markdown',\n];\nconst missing = required.filter((key) => payload[key] === undefined || payload[key] === null);\nif (missing.length) {\n  throw new Error(`promptforge_intake_payload_missing:${missing.join(',')}`);\n}\nconst orchestrationRoute = payload.requires_review\n  ? 'review'\n  : payload.mode === 'auto_dispatch'\n    ? 'dispatch'\n    : payload.mode === 'draft'\n      ? 'draft'\n      : 'queue';\nreturn [{\n  json: {\n    ...payload,\n    orchestration_route: orchestrationRoute,\n    event_source: 'promptforge-watcher',\n    received_at: new Date().toISOString(),\n    prompt_preview: String(payload.final_prompt_markdown).slice(0, 240),\n  },\n}];"
      },
