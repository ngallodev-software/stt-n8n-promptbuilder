{
  "name": "PromptForge Delivery Queue Processor",
  "nodes": [
    {
      "parameters": {
        "content": "Scheduled queue dispatcher. It fetches the next queued delivery from Postgres, marks it as dispatching, classifies the target adapter, and returns a compact dispatch envelope. Adapter-specific execution remains intentionally conservative until non-Obsidian adapters are implemented in Python."
      },
      "id": "0b743296-fecd-485d-bfd9-799b9e31d3ca",
      "name": "Workflow Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1120,
        -240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "fd8bf8a1-c5c5-408c-ba0d-6df72db4d8a3",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1080,
        20
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id AS delivery_id,\n       d.prompt_generation_id,\n       d.destination,\n       d.target_type,\n       d.target_identifier,\n       d.mode,\n       d.priority,\n       d.status,\n       pg.final_prompt_markdown,\n       pg.requires_review\nFROM deliveries d\nJOIN prompt_generations pg ON pg.id = d.prompt_generation_id\nWHERE d.status = 'queued'\nORDER BY CASE d.priority\n    WHEN 'urgent' THEN 1\n    WHEN 'high' THEN 2\n    WHEN 'normal' THEN 3\n    ELSE 4\nEND,\nqueued_at ASC\nLIMIT 1;"
      },
      "id": "4484f4e0-e263-44ba-a4e2-bf8ee2672872",
      "name": "Fetch Next Queued Delivery",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -820,
        20
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "PromptForge Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.delivery_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0a07f76b-c203-402f-9a60-96813e9a659c",
      "name": "Queued Delivery Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -560,
        20
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, workflow: 'promptforge-delivery-queue-processor', action: 'idle', message: 'No queued deliveries available.' } }}",
        "options": {}
      },
      "id": "8572167d-7dc2-4c8f-8856-4ab5ce423f9d",
      "name": "No Work Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -300,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE deliveries\nSET status = 'dispatching'\nWHERE id = '{{ $json.delivery_id }}';"
      },
      "id": "cc6ce47e-dd35-4f2c-9d9f-c580df1f7ba4",
      "name": "Mark Dispatching",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
