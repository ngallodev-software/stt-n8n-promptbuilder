        -40
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "PromptForge Postgres"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.target_type }}",
                    "rightValue": "generic_queue",
